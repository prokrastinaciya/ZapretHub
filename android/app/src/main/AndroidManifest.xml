<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.radolyn.ayugram" />
        <package android:name="com.exteragram.messenger" />
        <package android:name="org.telegram.plus" />
        <package android:name="ir.ilmili.telegraph" />
        <package android:name="org.telegram.BifToGram" />
        <package android:name="tw.nekomimi.nekogram" />
        <package android:name="xyz.nextalone.nagram" />
        <package android:name="uz.unnarsx.cherrygram" />
        <package android:name="org.telegram.mdgram" />
        <package android:name="org.forkclient.messenger.beta" />
        <package android:name="app.nicegram" />
        <package android:name="top.qwq2333.nullgram" />
        <package android:name="com.iMe.android" />
        <package android:name="ru.dahl.messenger" />
        <package android:name="com.scriptsaz.litegram" />
        <package android:name="org.thunderdog.challegram" />
        <!-- VPN application filter: see launchable apps without QUERY_ALL_PACKAGES
             (Play Protect-compliant). Only the launcher intent is queried, so no
             app's internal details become visible. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="com.amurcanov.tgwsproxy.AppUpdateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TGWSPROXY"
        tools:targetApi="33">

        <activity
            android:name="com.amurcanov.tgwsproxy.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.TGWSPROXY">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- LauncherApps starts shortcuts as their publisher. -->
        <activity
            android:name="com.amurcanov.tgwsproxy.LauncherShortcutActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Existing automation intents require confirmation. -->
        <activity
            android:name="com.amurcanov.tgwsproxy.ProxyShortcutActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.prokrastinaciya.zaprethub.action.START" />
                <action android:name="com.prokrastinaciya.zaprethub.action.STOP" />
                <action android:name="com.prokrastinaciya.zaprethub.action.TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ByeByeDPI launcher shortcut (no confirmation, like the TG one). -->
        <activity
            android:name="com.amurcanov.tgwsproxy.DpiLauncherShortcutActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ByeByeDPI external automation requires confirmation; VPN is never captured silently. -->
        <activity
            android:name="com.amurcanov.tgwsproxy.DpiShortcutActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.prokrastinaciya.zaprethub.action.dpi.START" />
                <action android:name="com.prokrastinaciya.zaprethub.action.dpi.STOP" />
                <action android:name="com.prokrastinaciya.zaprethub.action.dpi.TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.amurcanov.tgwsproxy.ProxyTilePreferencesActivity"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.amurcanov.tgwsproxy.ProxyService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled MTProto proxy available while Telegram is in use, with a stop action in the notification" />
        </service>

        <service
            android:name="com.amurcanov.tgwsproxy.dpi.DpiStrategyTestService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-initiated network strategy test with progress and cancellation while the screen is off" />
        </service>

        <service
            android:name="com.amurcanov.tgwsproxy.ProxyTileService"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true"
            android:icon="@drawable/ic_mark_mono"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <receiver
            android:name="com.amurcanov.tgwsproxy.ProxyNotificationStopReceiver"
            android:exported="false" />

        <!-- Start on the system broadcast only when the user enabled autostart. -->
        <receiver
            android:name="com.amurcanov.tgwsproxy.BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
